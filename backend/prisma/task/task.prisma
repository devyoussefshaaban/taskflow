enum Status {
    TODO
    ASSIGNED
    IN_PROGRESS
    COMPLETED
}

enum Priority {
    LOW
    MEDIUM
    HIGH
    URGENT
}

model Task {
    id          Int      @id @default(autoincrement())
    title       String
    description String
    priority    Priority @default(LOW)
    status      Status   @default(TODO)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

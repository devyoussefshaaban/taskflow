model Task {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  description String
  status      Status   @default(TODO)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  priority    Priority @default(LOW)
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

enum Status {
  TODO
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
